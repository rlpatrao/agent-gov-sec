# deploy/Dockerfile.service — the Galaxy governance enforcement service (mechanism 4).
#
# Packages the out-of-process chokepoints (LLM / data / A2A) as a single
# long-running container that the governance team owns and deploys in a separate
# environment under a separate identity. It ships only the governance library,
# the agnostic core, and the chokepoint handlers — never payload_agents, so the
# agent codebase cannot influence the authority that governs it.
#
# The same image runs locally (deploy/docker-compose.yml) and in production, so a
# developer tests against exactly what enforces in production.
#
#   docker build -f deploy/Dockerfile.service -t galaxy-enforcement:local .   # context = repo root
#   docker run -p 8080:8080 galaxy-enforcement:local
FROM python:3.12-slim

WORKDIR /app

# Chokepoint-only runtime deps (agent_os / agent_sre / agentmesh toolkit + OTel).
COPY cloud_adapters/aws/infra/lambda/requirements-proxy.txt ./
RUN pip install --no-cache-dir -r requirements-proxy.txt

# The enforcement library, the agnostic core, and the chokepoint handlers.
# NOTE: payload_agents is deliberately NOT copied — the chokepoints never import
# the agent codebase (the Lambda image applies the same rule).
COPY governance/ ./governance/
COPY core/ ./core/
COPY cloud_adapters/ ./cloud_adapters/

ENV PYTHONPATH=/app \
    GOV_ENFORCE_HOST=0.0.0.0 \
    GOV_ENFORCE_PORT=8080 \
    GOV_HANDLER_DIR=/app/cloud_adapters/aws/infra/lambda \
    GOV_POLICY_REGISTRY_PATH=/app/cloud_adapters/aws/infra/lambda/agent-controls.json

EXPOSE 8080

# Liveness for orchestrators (ECS/K8s/Container Apps).
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health',timeout=2).status==200 else 1)"

CMD ["python", "-m", "governance.remote.server"]
