# Galaxy Agentic Governance Platform — environment template
# Copy to .env and fill in the cloud you're running. NEVER commit .env.
#
# demo_agents.py loads .env automatically. Model selection is per-cloud: --azure /
# --gcp / --aws call their REAL model when the block below resolves; otherwise (or
# with --fake / --local) the deterministic fake model runs. Fill in only the
# cloud(s) you use; everything else can stay blank/commented.

# ══ AZURE — demo_agents.py (default) → Azure OpenAI ═════════════════════════════
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# Use a dated version (e.g. 2025-03-01-preview), not "preview". Reasoning/codex
# deployments (o-series, gpt-5*, *-codex) need 2025-03-01-preview+ and auto-route
# through the Responses API.
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_KEY=<your-aoai-key>
# Force the Responses API on/off (default: auto-detect from the deployment name):
# AZURE_OPENAI_USE_RESPONSES_API=1
# Optional — route through APIM instead of direct AOAI (egress chokepoint):
# APIM_ENDPOINT=https://<your-apim>.azure-api.net
# APIM_SUBSCRIPTION_KEY=<apim-subscription-key>

# ══ GCP — demo_agents.py --gcp → Vertex AI / Gemini  (needs: pip install '.[gcp]') ══
# Vertex via ADC: set the project + `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=<your-gcp-project>
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-pro
GOOGLE_GENAI_USE_VERTEXAI=True
# Gemini Developer API instead of Vertex/ADC (set a key, omit the project above):
# GOOGLE_API_KEY=<your-gemini-api-key>

# ══ AWS — demo_agents.py --aws → Bedrock via API Gateway  (needs: pip install '.[aws]') ══
# Provision the infra first: cd adapters/aws/infra && terraform apply (tagged galaxy-rp),
# then copy `terraform output` here. The agent reaches Bedrock ONLY through the API
# Gateway chokepoint (x-api-key) — it never holds Bedrock credentials.
AWS_REGION=us-east-1
AWS_PROFILE=<your-sso-profile>                 # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6              # terraform output bedrock_model_id
AWS_BEDROCK_GATEWAY_ENDPOINT=https://<api-id>.execute-api.us-east-1.amazonaws.com/prod/invoke   # output bedrock_gateway_url
# The gateway x-api-key — env fallback (no boto3 needed), or pull from Secrets Manager:
#   aws secretsmanager get-secret-value --secret-id galaxy/bedrock-gateway-key --query SecretString -o text
AWS_BEDROCK_GATEWAY_KEY=<gateway-api-key>
GALAXY_LEDGER_TABLE=galaxy-trace-ledger        # DynamoDB ledger (stdout mode if absent)
# Instance-metadata (IMDS) endpoint — AWS-wide constants; leave UNSET in real AWS.
# Override only for local testing / IPv6, using the standard AWS SDK variables:
# AWS_EC2_METADATA_SERVICE_ENDPOINT=http://169.254.169.254        # default IPv4 (fd00:ec2::254 for IPv6)
# AWS_EC2_METADATA_SERVICE_ENDPOINT_MODE=IPv4                     # or IPv6

# ══ Per-agent NHI identity (the 3 demo agents) ═════════════════════════════════
# Each agent's cloud principal id — Azure→Entra clientId, AWS→IAM role ARN, GCP→SA
# email. Placeholders are fine offline; the registry resolves NHI_CLIENT_ID_<AGENT>
# for whatever agent types you run (no hardcoded list). Add more as you add agents.
#
# This env bridge is the LOCAL-DEVELOPMENT path: the agent process supplies its own
# identity. When GOV_AUTHORITY_ENDPOINT is set (below), the Governance Authority is
# the authority for identity and these variables are ignored — otherwise an agent
# could bypass the authority by setting its own value.
NHI_CLIENT_ID_FINOPS=<finops-principal-id>
NHI_CLIENT_ID_AUDITOR=<auditor-principal-id>
NHI_CLIENT_ID_ROGUE=<rogue-principal-id>

# ══ Governance Authority — identity control plane ══════════════════════════════
# Agent side: resolve the NHI binding from the authority rather than from the env
# above. GOV_AUTHORITY_TOKEN is a READ credential for GET /identity; it does not
# permit enrollment, which additionally requires a verified human caller.
# GOV_AUTHORITY_ENDPOINT=http://localhost:8080
# GOV_AUTHORITY_TOKEN=<control-plane-read-token>
# GOV_AUTHORITY_TIMEOUT=5
#
# Authority side (governing team only). The control plane is DISABLED unless
# GOV_CONTROL_TOKEN is set, so an enforcement service deployed with data-plane
# config alone cannot enroll anything.
# GOV_CONTROL_TOKEN=<control-plane-token>
# GOV_IDENTITY_STORE=governance/configs/identity-bindings.yaml
# Role names permitted to enroll on behalf of CI, in addition to IAM users and AWS
# SSO sessions (comma-separated):
# GOV_ENROLL_ALLOWED_ROLES=gh-actions-deploy
# LOCAL DEVELOPMENT ONLY. Trusts the caller-ARN header without an IAM-authorizing
# front door. Never set this in production — it makes the enrolling identity
# forgeable by anyone who can reach the control plane.
# GOV_CONTROL_TRUST_HEADER=1

# ══ Observability + ledger (optional — stdout / no-op if blank) ════════════════
OTEL_SERVICE_NAME=galaxy-governance-local
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
# AZURE_KEY_VAULT_URL=https://<your-keyvault>.vault.azure.net/
# POSTGRES_DSN=postgresql://user:pass@<your-pg>.postgres.database.azure.com:5432/ledger

# ══ Azure reference infra — Method 1 Functions + orchestrator (optional) ═══════
# The out-of-process Function chokepoints (llm/data/a2a) read the exported policy
# registry, the same path the AWS proxies use:
# GOV_POLICY_REGISTRY_PATH=cloud_adapters/aws/infra/lambda/agent-controls.json
# The Container-Apps-Jobs orchestrator (cloud_adapters/azure/orchestrator.py):
# AZURE_SUBSCRIPTION_ID=<subscription-id>
# AZURE_RESOURCE_GROUP=<resource-group>
# The Azure SQL / Synapse FGAC pushdown enforcer (cloud_adapters/azure/data_fgac.py):
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=<host>;Database=<db>;...
# AZURE_SQL_SCHEMA=dbo

# ══ Guardrail feature flags (all OFF by default) ═══════════════════════════════
# Truthy = 1/true/yes/on. Source of truth: governance/extensions/flags.py.
# WS7 gap modules:
# GALAXY_GAP_DATA_FGAC=1          # data-layer FGAC mediator (Gap 1)
# GALAXY_GAP_DATA_DRIFT=1         # data-access drift detection (Gap 3)
# GALAXY_GAP_REASONING_GUARD=1    # reasoning-step validation (Gap 4)
# GALAXY_GAP_REASONING_TRACE=1    # CoT/CoVe trace logging (Gap 4+)
#
# Full-sweep guards — wired into the GuardPipeline hooks (see docs/extended-guardrails.md):
# GALAXY_GAP_EGRESS_POLICY=1      # before_tool: outbound URL allow-list (A3)
# GALAXY_GAP_CIRCUIT_BREAKER=1    # before_tool: per-tool circuit breaker (J1)
# GALAXY_GAP_SEMANTIC_POLICY=1    # before_tool: intent-classified tool policy (B4)
# GALAXY_GAP_SECURE_CODEGEN=1     # before_tool: static review of code args (C3)
# GALAXY_GAP_SECURE_EXEC=1        # before_tool: sandbox validation of exec'd code (C4)
# GALAXY_GAP_DIFF_POLICY=1        # before_tool: diff/patch policy (C5)
# GALAXY_GAP_MEMORY_GUARD=1       # before_tool: memory-write poisoning gate (G1)
# GALAXY_OPS_COST_GUARD=1         # before_tool: per-task/per-agent cost ceiling (J2)
# GALAXY_GAP_OUTPUT_PII=1         # after_model: output PII masking (F1)
# GALAXY_GAP_MCP_RESPONSE_SCAN=1  # after_tool: inbound MCP tool-output scan (E6)
# Context-specific / connect-time guards (demonstrated per agent):
# GALAXY_GAP_TRANSPARENCY=1       # tool-disclosure confirmation (L2)
# GALAXY_GAP_REVERSIBILITY=1      # irreversible-action gate (C6)
# GALAXY_GAP_CONSTRAINT_GRAPH=1   # per-agent constraint graph (C7)
# GALAXY_GAP_MCP_GATEWAY=1        # MCP tool allow/deny gateway (E1)
# GALAXY_GAP_MCP_RATE_LIMIT=1     # MCP sliding-window rate limit (E2)
# GALAXY_GAP_MCP_SESSION_AUTH=1   # MCP session token validation (E3)
# GALAXY_GAP_MCP_MESSAGE_SIGNING=1 # MCP envelope signing/replay (E4)
# GALAXY_GAP_MCP_TOOL_SCREEN=1    # MCP tool-definition poisoning screen (E5)
# GALAXY_GAP_HUMAN_ESCALATION=1   # HITL approval on sensitive actions (L1)
# GALAXY_GAP_CONTENT_QUALITY=1    # output content-quality gate (F2)
# Operational (fleet-level demo sections):
# GALAXY_OPS_SLO_BUDGET=1         # SLO + error-budget burn (N1)
# GALAXY_OPS_ACCURACY_DECL=1      # accuracy declaration vs SLI (N2)
# GALAXY_OPS_EVAL_JUDGE=1         # eval suite / RulesJudge (N3)
# GALAXY_OPS_REPLAY_GOLDEN=1      # golden-trace replay (N4)
# GALAXY_OPS_SBOM=1               # SBOM generation (N5)
# GALAXY_OPS_ARTIFACT_SIGNING=1   # Ed25519 artifact signing (N6)
# GALAXY_OPS_CERTIFICATION=1      # certification gate (N7)
# GALAXY_GAP_ADVERSARIAL_EVAL=1   # adversarial red-team harness (N8)

# ── Application wiring (the platform names no application paths) ─────────────
# Where agent-config YAMLs live. Importing the in-tree demo (payload_agents)
# registers its own config/ automatically; a separate agent repo sets this.
# GALAXY_AGENT_CONFIG_DIR=/path/to/your/agents/config
# Row source for the data chokepoint: a module exposing rows_for(dataset, table).
# Unset = /data answers 501 data_source_unconfigured (fail closed).
# GOV_DATA_SOURCE_MODULE=payload_agents._lib.demo_data
