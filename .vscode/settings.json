{
    "workbench.colorTheme": "Light Modern",
    // Hide regenerated build artifacts and caches from the explorer. All of
    // these are gitignored; deleting them is always safe.
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.egg-info": true,
        "**/.pytest_cache": true,
        "build": true,
        "dist": true,
        ".build": true
    }
}
